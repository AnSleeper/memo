{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "不许忘",
  "version": "0.1.0",
  "identifier": "com.buyaowang.memo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "不许忘！",
        "width": 940,
        "height": 640,
        "minWidth": 600,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**", "**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
